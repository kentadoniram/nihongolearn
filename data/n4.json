 "questions": [
  {"c": "k", "l": 4, "w": "待つ", "q": "Which one means “to wait” (まつ)?", "o": ["待つ", "持つ", "侍つ", "特つ"], "a": 0, "y": "待 has 彳 (a step): waiting is pacing in place. 持 has 扌 (hand): to hold. The left-side radical carries the meaning."},
  {"c": "v", "l": 4, "w": "開く", "q": "ドアが___ (the door opens by itself)", "o": ["あく", "あける", "あかる", "あけく"], "a": 0, "y": "あく is the intransitive verb: it happens by itself, with が. あける needs a person doing it: ドアを開ける."},
  {"c": "r", "l": 4, "w": "参考", "q": "How do you read 参考 (reference)?", "o": ["さんこう", "さんか", "さんせい", "ざんこう"], "a": 0, "y": "参 (さん) + 考 (こう, to think). 参加 (さんか, take part) and 賛成 (さんせい, agree) start the same, so the second kanji decides. Read the whole word, not just the start."},
  {"c": "g", "l": 4, "q": "ドアが開いて___。", "o": ["います", "あります", "いません", "ありません"], "a": 0, "y": "Intransitive verb + ている shows the resulting state: the door is open. Transitive verb + てある (開けてある) means someone left it that way on purpose.", "id": "g12"},
  {"c": "g", "l": 4, "q": "雨が降っている___、出かけません。", "o": ["ので", "のに", "けど", "ても"], "a": 0, "y": "ので gives a reason: because it is raining, I will not go out. のに means “even though” (unexpected), けど “but”, ても “even if”.", "id": "g13"},
  {"x": 1, "c": "g", "l": 4, "q": "宿題をしなければ___。", "o": ["なりません", "なります", "できません", "ありません"], "a": 0, "y": "～なければならない means must: literally “if you don’t do it, it won’t be okay”.", "id": "g16"}
 ],
 "sentences": [
  {"en": "My friend is studying Japanese.", "t": ["友達", "は", "日本語", "を", "勉強して", "います"], "tail": 2, "y": "Verb て-form + います means “is doing”. The two words stay together at the end.", "l": 4, "f": "teimasu"},
  {"en": "I opened the window.", "t": ["私", "は", "窓", "を", "開けました"], "tail": 1, "y": "The transitive verb 開ける takes を: someone opens something.", "l": 4, "f": "wo"},
  {"en": "The window is open.", "t": ["窓", "が", "開いて", "います"], "tail": 2, "y": "The intransitive 開く with が, plus ている, describes the resulting state.", "l": 4, "f": "teimasu"},
  {"en": "My mother is cooking.", "t": ["母", "は", "料理", "を", "して", "います"], "tail": 2, "l": 4, "f": "teimasu"},
  {"en": "I am reading a book.", "t": ["私", "は", "本", "を", "読んで", "います"], "tail": 2, "l": 4, "f": "teimasu"},
  {"en": "My brother is sleeping.", "t": ["兄", "は", "寝て", "います"], "tail": 2, "l": 4, "f": "teimasu"},
  {"en": "I want to go to Japan.", "t": ["私", "は", "日本", "に", "行きたいです"], "tail": 1, "l": 4, "f": "tai"},
  {"en": "I want to drink water.", "t": ["私", "は", "水", "が", "飲みたいです"], "tail": 1, "l": 4, "f": "tai"},
  {"en": "I want to see the sea.", "t": ["私", "は", "海", "が", "見たいです"], "tail": 1, "l": 4, "f": "tai"},
  {"en": "Please write your name.", "t": ["名前", "を", "書いて", "ください"], "tail": 2, "l": 4, "f": "tekudasai"},
  {"en": "Please open the window.", "t": ["窓", "を", "開けて", "ください"], "tail": 2, "l": 4, "f": "tekudasai"},
  {"en": "Please wait here.", "t": ["ここ", "で", "待って", "ください"], "tail": 2, "l": 4, "f": "tekudasai"}
 ],
 "patterns": [
  {"t": "Pairs: someone does it, or it happens", "ex": [["開ける", "open (something)"], ["開く", "open (by itself)"], ["閉める", "close (something)"], ["閉まる", "close (by itself)"], ["始める", "start (something)"], ["始まる", "begin (by itself)"]], "q": "Which group means 'someone does it to something'?", "o": ["開ける, 閉める, 始める", "開く, 閉まる, 始まる", "There is no difference"], "a": 0, "y": "Tendency: endings like -eru/-su belong to the doer, endings like -u/-aru to things that happen on their own. A tendency, not a law, so exceptions will come back later.", "id": "1", "l": 4}
 ],
 "reading": [
  {"t": "Reading", "l": 4, "p": "きのうは雨が降っていたので、出かけませんでした。家で料理をして、野菜のスープを作りました。", "q": "Why did the writer stay home?", "o": ["It was raining", "They were ill", "They had a meeting", "The station was closed"], "a": 0, "y": "ので marks the reason: 雨が降っていたので means “because it was raining”. 出かけませんでした means “did not go out”.", "id": "4"}
 ],
 "forms": [
  {"id": "teimasu", "l": 4, "name": "Is doing", "blocks": ["Topic は", "Object を", "Verb て います"], "note": "The て-form plus います describes something in progress or a continuing state.", "trap": "English “is eating” is one verb phrase. In Japanese both parts stay together at the end.", "ex": [["本を読んでいます。", "I am reading a book."], ["窓が開いています。", "The window is open."]]},
  {"id": "tai", "l": 4, "name": "Want to do", "blocks": ["Topic は", "Object が / を", "Verb stem + たいです"], "note": "Drop ます and add たい. The thing you want usually takes が.", "trap": "English “want to” comes before the verb. Japanese attaches たい to the verb itself.", "ex": [["日本に行きたいです。", "I want to go to Japan."], ["水が飲みたいです。", "I want to drink water."]]},
  {"id": "tekudasai", "l": 4, "name": "Please do", "blocks": ["Object を", "Verb て", "ください"], "note": "The て-form plus ください is a polite request.", "trap": "English puts “Please” first. Japanese puts ください last.", "ex": [["名前を書いてください。", "Please write your name."], ["窓を開けてください。", "Please open the window."]]}
 ]
}
