 "questions": [
  {"c": "v", "l": 5, "w": "水", "q": "水 means…", "o": ["water", "fire", "tree", "money"], "a": 0, "y": "水 (みず) is drawn from flowing water. Compare 火 (ひ, flames) and 木 (き, a tree): each kanji is a small picture."},
  {"c": "k", "l": 5, "w": "木", "q": "Which kanji means “tree”?", "o": ["木", "本", "末", "未"], "a": 0, "y": "木 is a trunk with branches and roots. 本 adds a stroke at the base (book). 末 and 未 differ only in which line is longer, so compare the top line with the bottom line."},
  {"c": "r", "l": 5, "w": "学校", "q": "How do you read 学校?", "o": ["がっこう", "がくこう", "がっこお", "かっこう"], "a": 0, "y": "学 (がく) + 校 (こう): く followed by a k-sound squeezes into a small っ, giving がっこう. The same sound change appears in many words."},
  {"c": "v", "l": 5, "w": "先生", "q": "先生 (せんせい) means…", "o": ["teacher", "student", "doctor", "friend"], "a": 0, "y": "先 “before” + 生 “life”: someone who came before you. 学生 (がくせい) is a student, so check the first kanji."},
  {"c": "k", "l": 5, "w": "犬", "q": "Which kanji means “dog” (いぬ)?", "o": ["犬", "大", "太", "天"], "a": 0, "y": "犬 is 大 (big) with a small dot, the dog’s ear. 太 (thick) has the dot lower. One stroke changes the meaning completely."},
  {"c": "v", "l": 5, "w": "おばあさん", "q": "おばあさん means…", "o": ["grandmother", "aunt", "mother", "older sister"], "a": 0, "y": "The long あ is the whole difference. おばさん is an aunt. Long and short vowels make different words."},
  {"c": "v", "l": 5, "w": "ビール", "q": "ビール means…", "o": ["beer", "building", "bill", "bottle"], "a": 0, "y": "The long mark ー stretches the vowel: ビール is beer, ビル (short) is a building."},
  {"c": "g", "l": 5, "q": "私___学生です。", "o": ["は", "が", "を", "に"], "a": 0, "y": "は marks the topic: “As for me, I am a student.” が would stress “it is me who is the student”. を marks objects and に marks destinations.", "id": "g10"},
  {"c": "g", "l": 5, "q": "駅___行きます。", "o": ["に", "を", "で", "が"], "a": 0, "y": "に marks the destination. で marks where an action happens (駅で待つ), and を marks the thing acted on.", "id": "g11"},
  {"x": 1, "c": "g", "l": 5, "q": "りんご___食べます。", "o": ["を", "に", "で", "が"], "a": 0, "y": "を marks the thing acted on.", "id": "g14"},
  {"x": 1, "c": "g", "l": 5, "q": "公園___友達に会いました。", "o": ["で", "に", "を", "は"], "a": 0, "y": "で marks the place where an action happens; に would mean a destination or where something exists.", "id": "g15"}
 ],
 "sentences": [
  {"en": "I eat sushi.", "t": ["私", "は", "寿司", "を", "食べます"], "tail": 1, "y": "Pattern: Topic は + Object を + Verb. The verb closes the sentence.", "l": 5, "f": "wo"},
  {"en": "I go to school by train.", "t": ["私", "は", "電車", "で", "学校", "に", "行きます"], "tail": 1, "y": "で marks the means, に marks the destination. These blocks can swap places, but the verb stays last.", "l": 5, "f": "de"},
  {"en": "Where is the station?", "t": ["駅", "は", "どこ", "です", "か"], "tail": 3, "y": "A question keeps the statement order and adds か at the end. The question word sits where the answer would.", "l": 5},
  {"en": "I will meet a friend tomorrow.", "t": ["明日", "友達", "に", "会います"], "tail": 1, "y": "Time words usually come first. に marks the person you meet.", "l": 5, "f": "ni"},
  {"en": "I drink coffee at the cafe.", "t": ["私", "は", "喫茶店", "で", "コーヒー", "を", "飲みます"], "tail": 1, "y": "で marks where an action happens, を marks what is acted on.", "l": 5, "f": "de"},
  {"en": "This is my mother.", "t": ["これ", "は", "母", "です"], "tail": 1, "l": 5, "f": "wa"},
  {"en": "My father is a teacher.", "t": ["父", "は", "先生", "です"], "tail": 1, "l": 5, "f": "wa"},
