 "patterns": [
  {"t": "Place + 人 means a person from there", "ex": [["日本人", "Japanese person"], ["中国人", "Chinese person"], ["外国人", "foreign person"]], "q": "What does adding 人 (じん) after a place do?", "o": ["Makes 'a person from there'", "Makes 'the language of there'", "Makes 'the food of there'"], "a": 0, "y": "Place + 人 = person from it. The same slot with 語 gives the language. Exception for your ledger: 人 alone is ひと.", "id": "0", "l": 5},
  {"t": "Katakana is English sound in Japanese clothes", "ex": [["コーヒー", "coffee"], ["ホテル", "hotel"], ["テレビ", "TV"], ["レストラン", "restaurant"]], "q": "ジュース is most likely…", "o": ["juice", "jealousy", "a kind of tree"], "a": 0, "y": "Say it aloud with Japanese sounds: ju-u-su. The long mark ー just stretches the vowel. Decode first, memorize second.", "id": "2", "l": 5}
 ],
 "reading": [
  {"t": "Reading", "l": 5, "p": "私は毎日、駅で友達に会います。二人で電車に乗って、学校に行きます。", "q": "How do they get to school?", "o": ["By train, together", "By bicycle, alone", "On foot, with a teacher", "By bus"], "a": 0, "y": "二人で means “the two of us” and 電車に乗って means “ride the train”. 駅で友達に会います tells you where they meet (で marks the place of an action).", "id": "3"}
 ],
