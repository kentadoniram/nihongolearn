 "forms": [
  {"id": "wa", "l": 5, "name": "A is B", "blocks": ["A は", "B", "です"], "note": "は marks what you are talking about and です closes the sentence politely. Japanese has no separate word for “is” in the middle.", "trap": "English: A is B. Japanese: A は B です, ending on です.", "ex": [["私は学生です。", "I am a student."], ["これは本です。", "This is a book."]]},
  {"id": "wo", "l": 5, "name": "Do something to X", "blocks": ["Topic は", "Object を", "Verb ます"], "note": "を marks what the action is done to, and the verb always comes last.", "trap": "English: I eat sushi (verb in the middle). Japanese: I sushi eat.", "ex": [["私は寿司を食べます。", "I eat sushi."], ["水を飲みます。", "I drink water."]]},
